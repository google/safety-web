{
  "name": "@safety-web/types",
  "version": "0.3.1",
  "license": "Apache-2.0",
  "author": "Google ISE Web Team",
  "repository": "https://github.com/google/safety-web",
  "dependencies": {
    "@protobuf-ts/plugin": "^2.9.4"
  },
  "exports": {
    ".": "./index.js",
    "./pipeline": "./pipeline.js"
  },
  "files": [
    "index.js",
    "pipeline.js"
  ],
  "engines": {
    "node": "^20.11.0 || >21.2.0"
  },
  "scripts": {
    "build": "wireit",
    "build:watch": "tsc -b ./tsconfig.json --watch",
    "lint": ":",
    "test": "SAFETY_WEB_LOG_PATH=NONE bash ./test.sh",
    "test:watch": ":",
    "gen": "wireit"
  },
  "wireit": {
    "gen": {
      "command": "yarn exec protoc --ts_out . --proto_path . index.proto pipeline.proto",
      "files": [
        "index.proto",
        "pipeline.proto"
      ],
      "output": [
        "index.ts",
        "pipeline.ts"
      ]
    },
    "build": {
      "command": "tsc -b ./tsconfig.json",
      "clean": "if-file-deleted",
      "files": [
        "*.ts",
        "tsconfig.json"
      ],
      "output": [
        "*.js"
      ],
      "dependencies": [
        "gen"
      ]
    }
  },
  "devDependencies": {
    "protoc": "^1.1.3",
    "typescript": "^5.8.3",
    "wireit": "^0.14.11"
  }
}
