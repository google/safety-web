{
  "name": "@safety-web/types",
  "version": "0.3.1",
  "license": "Apache-2.0",
  "author": "Google ISE Web Team",
  "repository": "https://github.com/google/safety-web",
  "dependencies": {
    "@protobuf-ts/plugin": "^2.9.4"
  },
  "exports": {
    ".": "./index.js",
    "./pipeline": "./pipeline.js"
  },
  "files": [
    "index.js",
    "pipeline.js"
  ],
  "engines": {
    "node": "^20.11.0 || >21.2.0"
  },
  "scripts": {
    "clean": "tsc --build --clean",
    "build": "tsc -b ./tsconfig.json",
    "build:watch": "tsc -b ./tsconfig.json --watch",
    "lint": ":",
    "test": "bash ./test.sh",
    "test:watch": ":",
    "update": "protoc --ts_out . --proto_path . index.proto pipeline.proto"
  },
  "devDependencies": {
    "protoc": "^1.1.3",
    "typescript": "^5.5.4"
  }
}
