{
  "name": "expect-violations",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "dependencies": {
    "chai": "^5.1.1",
    "yargs": "^17.7.2"
  },
  "engines": {
    "node": "^20.11.0 || >21.2.0"
  },
  "bin": "./bin/index.js",
  "scripts": {
    "build": "wireit",
    "build:watch": "tsc --watch",
    "lint": "eslint .",
    "test": "echo TODO"
  },
  "wireit": {
    "build": {
      "command": "tsc -b ./tsconfig.json && chmod +x bin/index.js",
      "clean": "if-file-deleted",
      "files": [
        "src/**/*.ts",
        "test/**/*.ts",
        "tsconfig.json"
      ],
      "output": [
        "bin/**"
      ]
    }
  },
  "devDependencies": {
    "@types/yargs": "^17.0.32",
    "eslint": "^8.56.0",
    "typescript": "^5.5.4"
  }
}
