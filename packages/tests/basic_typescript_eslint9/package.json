{
  "name": "basic-typescript-eslint9",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wireit",
    "lint": "echo skip lint script for integration test case",
    "test": "wireit",
    "update": "SAFETY_WEB_LOG_PATH=NONE eslint --format json | yarn run expect-violations update ./expected_violations.json"
  },
  "wireit": {
    "build": {
      "command": "wireit",
      "clean": "if-file-deleted",
      "files": [
        "src/**/*.ts",
        "tsconfig.json"
      ],
      "output": [
        "lib/**"
      ]
    },
    "test": {
      "command": "eslint --version | grep 'v9' && eslint --format json | yarn run expect-violations test ./expected_violations.json",
      "dependencies": [
        "../../test-helpers/expect-violations:build"
      ],
      "env": {
        "SAFETY_WEB_LOG_PATH": "NONE"
      }
    }
  },
  "devDependencies": {
    "@safety-web/eslint-plugin": "workspace:^",
    "eslint": "^9.6.0",
    "expect-violations": "workspace:^",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "wireit": "^0.14.12"
  }
}
