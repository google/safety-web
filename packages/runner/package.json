{
  "name": "@safety-web/runner",
  "version": "0.3.1",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Google ISE Web Team",
  "repository": "https://github.com/google/safety-web",
  "dependencies": {
    "@safety-web/eslint-formatter": "workspace:^",
    "@safety-web/eslint-plugin": "workspace:^",
    "@safety-web/types": "workspace:^",
    "debug": "^4.3.6",
    "eslint": "^9.6.0",
    "semver": "^7.6.3",
    "typescript-eslint": "^8.0.0",
    "winston": "^3.17.0",
    "yargs": "^17.7.2",
    "zx": "^8.1.4"
  },
  "bin": {
    "pipeline": "./bin/src/pipeline/pipeline.js",
    "runner": "./bin/src/index.js"
  },
  "engines": {
    "node": "^20.11.0 || >21.2.0"
  },
  "scripts": {
    "build": "wireit",
    "build:watch": "tsc --watch",
    "lint": "eslint .",
    "test": "SAFETY_WEB_LOG_PATH=NONE mocha test/**/*.ts",
    "test:watch": "SAFETY_WEB_LOG_PATH=NONE mocha -r ts-node/register --watch --watch-files src/**/*.ts,test/**/*.ts"
  },
  "wireit": {
    "build": {
      "command": "tsc -b ./tsconfig.json",
      "clean": "if-file-deleted",
      "files": [
        "src/**/*.ts",
        "test/**/*.ts",
        "tsconfig.json"
      ],
      "output": [
        "bin/**"
      ],
      "dependencies": [
        "../eslint-plugin:build",
        "../types:build"
      ]
    }
  },
  "devDependencies": {
    "@types/chai": "^4.3.16",
    "@types/debug": "^4.1.12",
    "@types/eslint": "^9.6.0",
    "@types/minimist": "^1",
    "@types/mocha": "^10.0.7",
    "@types/node": "^22.1.0",
    "@types/semver": "^7",
    "@types/yargs": "^17.0.32",
    "chai": "^5.1.1",
    "memfs": "^4.17.0",
    "minimist": "^1.2.8",
    "mocha": "^10.7.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
